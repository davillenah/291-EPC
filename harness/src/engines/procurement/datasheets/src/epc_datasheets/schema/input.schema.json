{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "datasheet requirements from circuits (input)",
  "description": "The arguments of requirements_from_circuits as one object.",
  "type": "object",
  "required": [
    "circuits"
  ],
  "properties": {
    "circuits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tag",
          "phases",
          "s_mm2"
        ],
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "phases": {
            "enum": [
              1,
              3
            ]
          },
          "s_mm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "neutral_mm2": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "pe_mm2": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "length_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "material": {
            "type": [
              "string",
              "null"
            ]
          },
          "insulation": {
            "type": [
              "string",
              "null"
            ]
          },
          "in_a": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "device_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "poles": {
            "enum": [
              1,
              2,
              3,
              4,
              null
            ]
          },
          "breaking_capacity_ka": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "tags must be unique"
    },
    "voltage_v": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    }
  }
}
