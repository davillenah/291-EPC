{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "epc_rfq input",
  "description": "The arguments of build_rfq(board_name, boq, *, suppliers, currency, response_deadline, delivery_site, validity_days, ...). The commercial terms have no defaults: the engine names every missing one.",
  "type": "object",
  "required": ["board_name", "boq", "suppliers", "currency", "response_deadline", "delivery_site", "validity_days"],
  "additionalProperties": false,
  "properties": {
    "board_name": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Name of the board the request is for."},
    "boq": {
      "type": "object",
      "required": ["items"],
      "description": "The structure of epc_boq.build_boq as a plain dict; unknown keys are ignored.",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item_id", "category", "description", "unit"],
            "properties": {
              "item_id": {"type": "string", "minLength": 1},
              "category": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "unit": {"type": "string", "minLength": 1},
              "quantity": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "A line without quantity is carried and flagged."},
              "source": {"type": "array", "items": {"type": "string"}},
              "issues": {"type": "array", "items": {"type": "string"}},
              "spec": {"type": "object"}
            }
          }
        }
      }
    },
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "description": "Names are unique, case-insensitive (a rule of the engine).",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string", "minLength": 1, "pattern": "\\S"}, "contact": {"type": ["string", "null"]}}
      }
    },
    "currency": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "response_deadline": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO calendar date YYYY-MM-DD."},
    "delivery_site": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "validity_days": {"type": "integer", "minimum": 1},
    "payment_terms": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "datasheets": {"type": ["object", "null"], "description": "The structure of epc_datasheets.build_datasheets as a plain dict."},
    "requestable_categories": {"type": ["array", "null"], "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
