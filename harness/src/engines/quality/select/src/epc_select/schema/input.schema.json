{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "select (input)",
  "description": "The arguments of select() as one object. `match` and `max_results` have no default.",
  "type": "object",
  "required": ["records", "conditions", "match", "max_results"],
  "additionalProperties": false,
  "properties": {
    "records": {"type": "array", "items": {"type": "object"}},
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "op"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge", "in", "contains", "exists"]},
          "value": {}
        }
      }
    },
    "match": {"enum": ["all", "any"]},
    "max_results": {"type": "integer", "minimum": 1}
  }
}
