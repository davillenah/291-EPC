{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terminal-block list (input)",
  "description": "The arguments of build_terminal_list as one object.",
  "type": "object",
  "required": [
    "board_name",
    "circuits"
  ],
  "properties": {
    "board_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "circuits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tag",
          "phases",
          "s_mm2"
        ],
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "phases": {
            "enum": [
              1,
              3
            ]
          },
          "s_mm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pe_mm2": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "neutral_mm2": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "in_a": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "tags must be unique"
    },
    "start_strip": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$"
    }
  }
}
