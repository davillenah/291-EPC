{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "epc_descriptive_report input",
  "description": "The arguments of build_descriptive_report(design_basis, circuits, *, terminals, boq, pending_documents, unreviewed_norm_records). Circuit tags are unique (a rule of the engine).",
  "type": "object",
  "required": ["design_basis", "circuits"],
  "additionalProperties": false,
  "properties": {
    "design_basis": {
      "type": "object",
      "required": ["sections"],
      "description": "The output of epc_design_basis.build_design_basis_document.",
      "properties": {
        "sections": {"type": "array", "items": {"type": "object", "required": ["id", "items"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "items": {"type": "array"}}}},
        "open_items": {"type": "array"}
      }
    },
    "circuits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tag"],
        "properties": {
          "tag": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "kind": {"type": "string"},
          "phases": {"type": "integer", "enum": [1, 3]},
          "device_kind": {"type": "string"},
          "s_mm2": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "material": {"type": "string"},
          "insulation": {"type": "string"},
          "length_m": {"type": ["number", "null"]}
        }
      }
    },
    "terminals": {"type": ["object", "null"], "description": "The structure of epc_terminal_blocks.build_terminal_list."},
    "boq": {"type": ["object", "null"], "description": "The structure of epc_boq.build_boq."},
    "pending_documents": {"type": ["array", "null"], "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"type": "string"}, "reason": {"type": "string"}}}},
    "unreviewed_norm_records": {"type": ["integer", "null"], "minimum": 0}
  }
}
