    "type": "heterojunction (HJT), bifacial",
    "n_cells_typical": [
      80,
      120
    ],
    "half_cut": true,
    "bifacial": true,
    "status": "unverified",
    "source_ids": [
      "rec_alpha_pure_r",
      "mb_white"
    ],
    "note": "REC: 80 half-cut bifacial heterojunction cells. Meyer Burger WHITE: 120 half cells, 'mono n-Si, HJT met SWCTT' (SmartWire, no conventional busbars). Busbar count not stated for either."
  },
