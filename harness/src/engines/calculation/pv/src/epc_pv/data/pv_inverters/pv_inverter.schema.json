{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "PV inverter type or inverter-side equipment (physical parts and ratings for 2D/3D modelling)",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "name",
  "kind",
  "description",
  "parts",
  "geometry",
  "status",
  "sources"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.-]+$"
  },
  "name": {
   "type": "object",
   "required": [
    "en",
    "es"
   ],
   "properties": {
    "en": {
     "type": "string"
    },
    "es": {
     "type": "string"
    }
   }
  },
  "kind": {
   "enum": [
    "inverter_type",
    "accessory"
   ],
   "description": "inverter_type = string, hybrid, micro, central, power station; accessory = combiner box, DC/AC disconnect, SPD, monitoring, mounting bracket, cable, rapid shutdown, optimizer"
  },
  "description": {
   "type": "object",
   "required": [
    "en",
    "es"
   ],
   "properties": {
    "en": {
     "type": "string"
    },
    "es": {
     "type": "string"
    }
   }
  },
  "typical_use": {
   "type": "string"
  },
  "layers": {
   "type": "array",
   "description": "Optional: internal build-up front to back (e.g. enclosure shell, heatsink, PCB stack) with thickness in mm; may be []",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "material",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "material": {
      "type": "string"
     },
     "thickness_mm": {
      "type": "number"
     },
     "note": {
      "type": "string"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "features": {"type": "array", "description": "Small recognisable details of the part (the dot at a corner, a label field, a hole) so it can be redrawn from this record: on = element id, face, position_mm [u, v] on the face from its lower-left corner seen from outside, size_mm [w, h], depth_mm (negative = recess).", "items": {"type": "object", "required": ["id", "kind", "face", "position_mm", "size_mm", "status"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"enum": ["dot", "box", "hole", "label"]}, "on": {"type": "string"}, "face": {"enum": ["front", "back", "left", "right", "top", "bottom"]}, "position_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "size_mm": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 2}, "depth_mm": {"type": "number"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}}},
  "parts": {
   "type": "array",
   "description": "Every physical part: frame profiles, corner keys, junction box, bypass diodes, connectors (MC4), cables, busbars/ribbons, mounting/grounding holes, labels, sealant, drain holes",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "type",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "enum": [
       "enclosure",
       "heatsink",
       "fan",
       "dc_switch",
       "dc_input",
       "mppt_input",
       "ac_terminal",
       "ac_output",
       "connector",
       "cable",
       "display",
       "led_indicator",
       "comm_port",
       "antenna",
       "mounting_bracket",
       "mounting_hole",
       "grounding_terminal",
       "spd",
       "fuse",
       "breaker",
       "contactor",
       "transformer",
       "busbar",
       "gland",
       "vent",
       "label",
       "gasket",
       "sealant",
       "other"
      ]
     },
     "material": {
      "type": "string"
     },
     "dimensions_mm": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "section_polygon_mm": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     },
     "quantity_per_module": {
      "type": "number"
     },
     "ratings": {
      "type": "object",
      "description": "e.g. rated current/voltage, IP rating, cable section",
      "additionalProperties": true
     },
     "geometry_hint": {
      "type": "string"
     },
     "standard": {
      "type": "string"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "geometry": {
   "type": "object",
   "required": [
    "description",
    "elements"
   ],
   "properties": {
    "description": {
     "type": "string"
    },
    "coordinate_system": {
     "type": "string",
     "default": "x along module long side, y along short side, z up through thickness; origin at module front-left corner; mm"
    },
    "module_dimensions_mm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3,
     "description": "length, width, thickness (typical)"
    },
    "clamping_zones_mm": {
     "type": "array",
     "description": "allowed clamp zones from a short/long edge",
     "items": {
      "type": "object"
     }
    },
    "elements": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "kind",
       "part_id",
       "position_mm",
       "rotation_deg",
       "size_mm",
       "status"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "part_id": {
        "type": "string"
       },
       "position_mm": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "rotation_deg": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "size_mm": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "note": {
        "type": "string"
       },
       "status": {
        "$ref": "#/$defs/status"
       }
      }
     }
    }
   }
  },
  "mechanical_ratings": {
   "type": "object",
   "additionalProperties": true,
   "description": "typical loads, weight range, IP, fire class, standards (IEC 61215, IEC 61730)"
  },
  "status": {
   "$ref": "#/$defs/status"
  },
  "unverified_items": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "url"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "accessed": {
      "type": "string"
     }
    }
   }
  },
  "electrical_ratings": {
   "type": "object",
   "additionalProperties": true,
   "description": "only sourced values: topology, phases, rated AC power kW/kVA, max DC voltage V, MPPT voltage range, number of MPPT/inputs, max input current per MPPT, AC voltage, efficiency, IP rating, temperature range, weight kg, protection class, certifications (IEC 62109, IEC 61727, IEC 62116, IEC 61683, EN 50549)"
  },
  "mechanical": {
   "type": "object",
   "additionalProperties": true,
   "description": "external dimensions WxHxD mm, weight, mounting method, clearances, cooling, noise"
  }
 },
 "$defs": {
  "status": {
   "enum": [
    "unverified",
    "verified",
    "typical",
    "not_found"
   ],
   "description": "never set verified (only a person); unverified = sourced; typical = generic industry value; not_found = never guessed"
  }
 }
}