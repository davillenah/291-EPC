{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PV mounting structure (support type with all its accessories)",
  "type": "object",
  "required": ["schema_version", "id", "name", "family", "category", "description", "materials", "profiles", "geometry", "accessories", "status", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "name": {"type": "object", "required": ["en", "es"], "properties": {"en": {"type": "string"}, "es": {"type": "string"}}},
    "family": {"enum": ["ground", "roof"]},
    "category": {"type": "string", "description": "e.g. driven_pile_fixed_table, single_axis_tracker, trapezoidal_sheet_rail, flat_roof_ballast"},
    "description": {"type": "object", "required": ["en", "es"], "properties": {"en": {"type": "string"}, "es": {"type": "string"}}},
    "typical_use": {"type": "string"},
    "applicable_standards": {"type": "array", "items": {"type": "string"}},
    "materials": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["component", "material", "status"], "properties": {"component": {"type": "string"}, "material": {"type": "string"}, "finish": {"type": "string"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
    "features": {"type": "array", "description": "Small recognisable details of the part (the dot at a corner, a label field, a hole) so it can be redrawn from this record: on = element id, face, position_mm [u, v] on the face from its lower-left corner seen from outside, size_mm [w, h], depth_mm (negative = recess).", "items": {"type": "object", "required": ["id", "kind", "face", "position_mm", "size_mm", "status"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"enum": ["dot", "box", "hole", "label"]}, "on": {"type": "string"}, "face": {"enum": ["front", "back", "left", "right", "top", "bottom"]}, "position_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "size_mm": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 2}, "depth_mm": {"type": "number"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}}},
    "profiles": {"type": "array", "description": "Cross sections for 2D/3D extrusion; dimensions in mm", "items": {"type": "object", "required": ["id", "name", "section_type", "dimensions_mm", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "section_type": {"enum": ["C", "Z", "U", "omega", "hat", "rect_tube", "round_tube", "H_beam", "I_beam", "L_angle", "T", "flat_bar", "rail_custom", "other"]}, "dimensions_mm": {"type": "object", "description": "named dimensions, e.g. height, width, thickness, flange, lip, diameter; only known values", "additionalProperties": {"type": "number"}}, "polygon_mm": {"type": "array", "description": "optional simplified closed outline [[x,y],...]", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}, "material": {"type": "string"}, "typical_length_mm": {"type": "number"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
    "geometry": {"type": "object", "required": ["description", "elements"], "properties": {"description": {"type": "string"}, "coordinate_system": {"type": "string", "default": "x along module row, y up-slope/north-south horizontal, z up; origin at ground/roof contact of first support; mm and degrees"}, "tilt_range_deg": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "elements": {"type": "array", "description": "Parts placed relative to the origin for 2D/3D modelling", "items": {"type": "object", "required": ["id", "kind", "profile_or_accessory_id", "position_mm", "rotation_deg", "length_mm", "status"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["post", "rail", "purlin", "beam", "brace", "foot", "base", "plate", "clamp", "bracket", "fastener", "other"]}, "profile_or_accessory_id": {"type": "string"}, "position_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "rotation_deg": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "length_mm": {"type": "number"}, "count": {"type": "number"}, "note": {"type": "string"}, "status": {"$ref": "#/$defs/status"}}}}, "reference_layout": {"type": "object", "description": "reference configuration for quantities (e.g. 2 rows x 12 modules portrait)", "properties": {"modules_per_unit": {"type": "number"}, "module_dimensions_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "orientation": {"enum": ["portrait", "landscape"]}, "note": {"type": "string"}}}}},
    "accessories": {"type": "array", "description": "Every accessory: bolts, nuts, washers, clamps, brackets, connectors, hooks, grounding, sealants, etc.", "items": {"type": "object", "required": ["id", "name", "type", "quantity", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"enum": ["bolt", "screw", "nut", "washer", "anchor", "clamp_mid", "clamp_end", "bracket", "hook", "connector_splice", "rail_end_cap", "foot", "base_plate", "ballast", "brace", "grounding", "sealant", "gasket", "cable_clip", "pile_cap", "other"]}, "material": {"type": "string"}, "grade": {"type": "string", "description": "e.g. A2-70, 8.8, 10.9, HDG"}, "standard": {"type": "string", "description": "e.g. ISO 4017, DIN 933"}, "thread": {"type": "string", "description": "e.g. M8, M10"}, "dimensions_mm": {"type": "object", "additionalProperties": {"type": "number"}}, "torque_nm": {"type": "number"}, "quantity": {"type": "object", "required": ["value", "per"], "properties": {"value": {"type": "number"}, "per": {"enum": ["module", "table", "post", "rail", "row", "support", "kWp", "unit"]}, "note": {"type": "string"}}}, "purpose": {"type": "string"}, "geometry_hint": {"type": "string", "description": "simple shape for 3D (e.g. cylinder d=8 l=25, box 40x30x4)"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
    "grounding_bonding": {"type": "string"},
    "installation_notes": {"type": "array", "items": {"type": "string"}},
    "status": {"$ref": "#/$defs/status"},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "url"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": "string"}, "accessed": {"type": "string"}}}}
  },
  "$defs": {"status": {"enum": ["unverified", "verified", "typical", "not_found"], "description": "unverified = from a single/secondary source, pending review; typical = generic industry value; not_found = could not be found (never guessed); verified = only a person sets it"}}
}
