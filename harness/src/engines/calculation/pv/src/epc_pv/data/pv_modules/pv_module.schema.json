{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PV module type (technology or format) with physical parts for 2D/3D modelling",
  "type": "object",
  "required": ["schema_version", "id", "name", "kind", "description", "layers", "parts", "geometry", "status", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "name": {"type": "object", "required": ["en", "es"], "properties": {"en": {"type": "string"}, "es": {"type": "string"}}},
    "kind": {"enum": ["technology", "format"], "description": "technology = cell/module technology (PERC, TOPCon, HJT, IBC, CdTe, CIGS, BIPV...); format = physical size class / component family (M10 72-cell, G12 66-cell, 60-cell, 54-cell, frame profiles, junction boxes, connectors)"},
    "description": {"type": "object", "required": ["en", "es"], "properties": {"en": {"type": "string"}, "es": {"type": "string"}}},
    "typical_use": {"type": "string"},
    "cell": {"type": "object", "description": "cell data, only known values", "properties": {"type": {"type": "string"}, "format": {"type": "string"}, "size_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "busbars": {"type": "number"}, "half_cut": {"type": "boolean"}, "bifacial": {"type": "boolean"}, "n_cells_typical": {"type": "array", "items": {"type": "number"}}, "efficiency_range_pct": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}},
    "layers": {"type": "array", "description": "Laminate stack from front to back, thickness in mm", "items": {"type": "object", "required": ["id", "name", "material", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "material": {"type": "string"}, "thickness_mm": {"type": "number"}, "note": {"type": "string"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
    "parts": {"type": "array", "description": "Every physical part: frame profiles, corner keys, junction box, bypass diodes, connectors (MC4), cables, busbars/ribbons, mounting/grounding holes, labels, sealant, drain holes", "items": {"type": "object", "required": ["id", "name", "type", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"enum": ["frame_profile", "corner_key", "junction_box", "bypass_diode", "connector", "cable", "busbar_ribbon", "cell_string", "glass", "encapsulant", "backsheet", "sealant", "mounting_hole", "grounding_hole", "label", "drain_hole", "cell", "other"]}, "material": {"type": "string"}, "dimensions_mm": {"type": "object", "additionalProperties": {"type": "number"}}, "section_polygon_mm": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}, "quantity_per_module": {"type": "number"}, "ratings": {"type": "object", "description": "e.g. rated current/voltage, IP rating, cable section", "additionalProperties": true}, "geometry_hint": {"type": "string"}, "standard": {"type": "string"}, "status": {"$ref": "#/$defs/status"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}},
    "geometry": {"type": "object", "required": ["description", "elements"], "properties": {"description": {"type": "string"}, "coordinate_system": {"type": "string", "default": "x along module long side, y along short side, z up through thickness; origin at module front-left corner; mm"}, "module_dimensions_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "length, width, thickness (typical)"}, "clamping_zones_mm": {"type": "array", "description": "allowed clamp zones from a short/long edge", "items": {"type": "object"}}, "elements": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "part_id", "position_mm", "rotation_deg", "size_mm", "status"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "part_id": {"type": "string"}, "position_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "rotation_deg": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "size_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "note": {"type": "string"}, "status": {"$ref": "#/$defs/status"}}}}}},
    "mechanical_ratings": {"type": "object", "additionalProperties": true, "description": "typical loads, weight range, IP, fire class, standards (IEC 61215, IEC 61730)"},
    "status": {"$ref": "#/$defs/status"},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "url"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": "string"}, "accessed": {"type": "string"}}}}
  },
  "$defs": {"status": {"enum": ["unverified", "verified", "typical", "not_found"], "description": "never set verified (only a person); unverified = sourced; typical = generic industry value; not_found = never guessed"}}
}
