{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sld_mld.pv.schema.json",
  "title": "PV SLD/MLD records: architecture scheme, device, and selection rules",
  "description": "One schema for the three record kinds of the PV research. Each file sets record_type. Status vocabulary: unverified (sourced, not checked by a person), typical (generic, no source), not_found (not found, never guessed), pending review (norm value, awaits a person). Nothing is verified.",
  "oneOf": [
    {"$ref": "#/$defs/scheme"},
    {"$ref": "#/$defs/device"},
    {"$ref": "#/$defs/rules"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "i18n": {
      "type": "object",
      "required": ["en", "es"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "es": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "enum": ["unverified", "typical", "not_found", "pending review"]
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "url", "publisher", "accessed", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^(https://|repo://)"},
        "publisher": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "kind": {"enum": ["manufacturer", "third_party_guide", "standard_public_summary", "textbook_wiki", "internal_repo"]}
      }
    },
    "rating": {
      "type": "object",
      "required": ["parameter", "value", "unit", "status", "source_ids", "note"],
      "additionalProperties": false,
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "unit": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "note": {"$ref": "#/$defs/i18n"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["unverified", "pending review"]}}, "required": ["status"]},
          "then": {"properties": {"source_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_found"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "scheme": {
      "type": "object",
      "required": ["schema_version", "record_type", "id", "name", "description", "purpose", "architecture", "voltage_level", "status", "chain", "device_refs", "drawing_conventions", "source_ids", "sources"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "scheme"},
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/i18n"},
        "description": {"$ref": "#/$defs/i18n"},
        "purpose": {"$ref": "#/$defs/i18n"},
        "architecture": {
          "enum": ["string_inverter_lv", "central_inverter_mv_station", "microinverter_lv", "optimizer_string_lv", "hybrid_dc_coupled", "hybrid_ac_coupled", "off_grid_island", "self_consumption_zero_injection"]
        },
        "voltage_level": {"enum": ["LV", "MV"]},
        "status": {"$ref": "#/$defs/status"},
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["order", "device_id", "label", "notes"],
            "additionalProperties": false,
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "device_id": {"$ref": "#/$defs/id"},
              "label": {"$ref": "#/$defs/i18n"},
              "notes": {"$ref": "#/$defs/i18n"}
            }
          }
        },
        "device_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "uniqueItems": true,
          "description": "Ids used in chain: existing sld_mld/devices ids, new pv devices ids, or repo inverter ids (dotted)."
        },
        "drawing_conventions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/i18n"}},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/i18n"}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "device": {
      "type": "object",
      "required": ["schema_version", "record_type", "id", "name", "description", "kind", "voltage_level", "status", "source_ids", "sources", "standard_refs", "ratings", "selection_criteria"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "device"},
        "id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/i18n"},
        "description": {"$ref": "#/$defs/i18n"},
        "kind": {
          "enum": ["breaker", "rcd", "fuse", "switch", "spd", "protection_relay", "metering", "transformer", "board", "inverter", "pv_combiner", "pv_dc_switch", "pv_diode", "microinverter", "power_optimizer", "battery_inverter", "pv_rapid_shutdown", "pv_power_station", "insulation_monitor"]
        },
        "voltage_level": {"enum": ["LV", "MV"]},
        "status": {"$ref": "#/$defs/status"},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "standard_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "note"],
            "additionalProperties": false,
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "note": {"$ref": "#/$defs/i18n"}
            }
          }
        },
        "ratings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rating"}},
        "selection_criteria": {
          "type": "object",
          "required": ["when_to_use", "when_not_to_use"],
          "additionalProperties": false,
          "properties": {
            "when_to_use": {"type": "array", "items": {"$ref": "#/$defs/i18n"}},
            "when_not_to_use": {"type": "array", "items": {"$ref": "#/$defs/i18n"}}
          }
        },
        "notes": {"type": "array", "items": {"$ref": "#/$defs/i18n"}}
      }
    },
    "rules": {
      "type": "object",
      "required": ["schema_version", "record_type", "id", "description", "variables", "rules", "sources"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "rules"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/i18n"},
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["enum", "boolean", "number"]},
              "values": {"type": "array", "items": {"type": "string"}},
              "unit": {"type": "string"}
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "domain", "when", "then", "status", "source_ids"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^r[0-9]{2}$"},
              "domain": {"enum": ["dc_protection", "dc_spd", "ac_protection", "rcd", "interface", "islanding", "battery", "rapid_shutdown", "connection_point", "earthing", "local_sources"]},
              "when": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["variable", "op", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "variable": {"type": "string"},
                    "op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in"]},
                    "value": {}
                  }
                }
              },
              "then": {
                "type": "object",
                "required": ["select", "rationale"],
                "additionalProperties": false,
                "properties": {
                  "select": {"type": "string", "minLength": 1},
                  "rationale": {"$ref": "#/$defs/i18n"}
                }
              },
              "status": {"$ref": "#/$defs/status"},
              "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
              "conflict_ref": {"type": "string", "pattern": "^c[0-9]{2}$"}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"enum": ["unverified", "pending review"]}}, "required": ["status"]},
                "then": {"properties": {"source_ids": {"minItems": 1}}}
              }
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "topic", "sources", "note"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^c[0-9]{2}$"},
              "topic": {"type": "string"},
              "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
              "note": {"$ref": "#/$defs/i18n"}
            }
          }
        }
      }
    }
  }
}
