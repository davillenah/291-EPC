{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Loads and sources of a model (end points: lighting, socket, motor, PV string...)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "model_id",
  "loads",
  "board"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "model_id": {
   "type": "string",
   "pattern": "^[a-z0-9_.-]+$"
  },
  "description": {
   "type": "object",
   "required": [
    "en",
    "es"
   ],
   "properties": {
    "en": {
     "type": "string"
    },
    "es": {
     "type": "string"
    }
   }
  },
  "status": {
   "enum": [
    "unverified",
    "typical",
    "not_found",
    "pending review"
   ]
  },
  "loads": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "tag",
     "kind",
     "symbol"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^load-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "stable id built from the circuit tag and the role, never from a counter"
     },
     "tag": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "load",
       "source"
      ]
     },
     "symbol": {
      "type": [
       "string",
       "null"
      ]
     },
     "load_ref": {
      "type": [
       "string",
       "null"
      ],
      "description": "id of the row in the project load list (the calculation); null in a typical model"
     }
    }
   }
  },
  "board": {
   "type": "string",
   "description": "tag of the board (tablero) this model belongs to; one model per board"
  }
 }
}