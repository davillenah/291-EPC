{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transmittal manifest (PRD section 13)",
  "description": "One JSON per transmittal (one issue of the project), written under projects/<client>/<project>/.epc/manifests/<transmittal>.manifest.json by the pipeline (stage 12) through the project store. It covers every file of deliverables/<transmittal>/ with its SHA-256 (a document without a rendered file has path null). `signed` is a human act and stays null until a person signs; regenerating a deliverable moves a previous signature to `superseded_signature` and fills `superseded_by`. D21: a manifest can be `approved_for_construction` only when every norm record it lists is `verified`.",
  "type": "object",
  "required": ["transmittal", "title", "revision", "pipeline_run_id", "inputs", "engines", "normative_profile", "files", "findings",
               "review_status", "signed", "superseded_signature", "supersedes", "superseded_by"],
  "properties": {
    "transmittal": {"type": "string", "pattern": "^TR-[0-9]{3,4}$"},
    "title": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,15}$"},
    "pipeline_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "additionalProperties": false
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "normative_profile": {
      "type": "object",
      "required": ["revisions", "norm_records"],
      "properties": {
        "revisions": {"type": "object"},
        "norm_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "review_status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "review_status": {"type": "string", "enum": ["verified", "pending review", "rejected"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "title", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "code": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[A-Z]{2,4}-[A-Z]{2,4}-[A-Z0-9]{3,6}-E-(LV|MV)-[A-Z]{3}-[0-9]{3}(-L(S?)[0-9]{2})?$"},
          "path": {"type": ["string", "null"], "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "run_id", "verifier", "severity", "document", "field", "value", "expected", "clause", "action", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]{4}$"},
          "run_id": {"type": "string"},
          "verifier": {"type": "string", "enum": ["format-check", "calc-check", "document-check", "input-verifier", "standards-reviewer", "final-auditor"]},
          "severity": {"type": "string", "enum": ["blocking", "major", "minor", "note"]},
          "document": {"type": "string"},
          "field": {"type": "string"},
          "value": {},
          "expected": {},
          "clause": {"type": "string"},
          "action": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "unreviewed_values": {"type": "array", "items": {"type": "string"}},
          "merged_from": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["open", "accepted", "fixed", "rejected"]}
        },
        "additionalProperties": false
      }
    },
    "review_status": {"type": "string", "enum": ["draft", "for_review", "approved_for_construction"]},
    "mode": {"type": "string", "enum": ["edit"], "description": "Present only when the package was made in edit mode (ADR-0035): norm records not verified did not stop the workflow and the package is not for production."},
    "signed": {
      "type": ["object", "null"],
      "required": ["signer", "date"],
      "properties": {"signer": {"type": "string", "minLength": 1}, "date": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "superseded_signature": {
      "type": ["object", "null"],
      "required": ["signer", "date"],
      "properties": {"signer": {"type": "string", "minLength": 1}, "date": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "supersedes": {"type": ["string", "null"], "minLength": 1},
    "superseded_by": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false,
  "if": {"required": ["review_status"], "properties": {"review_status": {"enum": ["approved_for_construction"]}}},
  "then": {
    "properties": {
      "normative_profile": {
        "properties": {"norm_records": {"items": {"properties": {"review_status": {"enum": ["verified"]}}}}}
      }
    }
  }
}
