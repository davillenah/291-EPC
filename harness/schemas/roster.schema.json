{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roster.schema.json",
  "title": "Roster of the product agents (PRD 14.2): the only place for model, effort, tools, skills and turn limit",
  "type": "object",
  "required": ["schema_version", "agents"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "model", "effort", "tools", "skills", "max_turns", "summary_prompt_rules"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"type": "string", "minLength": 10},
          "model": {"type": "string", "pattern": "^claude-[a-z0-9-]+$"},
          "effort": {"type": "string", "enum": ["low", "medium", "high"]},
          "tools": {"type": "array", "items": {"type": "string", "pattern": "^(Read|Grep|Glob|Bash|Write|Edit|mcp__epc__epc_[a-z_]+)$"}},
          "skills": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "max_turns": {"type": "integer", "minimum": 1},
          "summary_prompt_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
        }
      }
    }
  }
}
