{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Load list by area (PRD section 11)",
  "description": "Loads of the installation grouped by area: lighting, receptacles, motors and special loads. Powers are declared by the engineer; nothing here is calculated.",
  "type": "object",
  "required": ["schema_version", "areas", "loads"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "plan": {"type": "string", "minLength": 1, "description": "Path of the architecture plan of this area, relative to inputs/"}
        },
        "additionalProperties": false
      }
    },
    "loads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "area", "kind", "power", "phases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["lighting", "receptacles", "motor", "special"]},
          "power": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "enum": ["W", "kW", "VA", "kVA"]}
            },
            "additionalProperties": false
          },
          "phases": {"type": "integer", "enum": [1, 3]},
          "length": {
            "type": "object",
            "description": "Run length from the board to the load, when known.",
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "enum": ["m"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
