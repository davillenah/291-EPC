# ===== Private / never versioned =====
# local/ holds dev-knowledge (standards, third-party reports, study material), legacy (archived folders and
# old repositories), projects-demo (simulated data) and projects (real client projects, each in its own repo)
/local/
_study/

# ===== Copyrighted / CAD binaries =====
*.pdf
*.dwg
*.dwl
*.dwl2
!docs/**/*.pdf
!harness/docs/**/*.pdf
# study material and standards live only in /local/ (see harness/docs/explanation/knowledge.md); knowledge extracted by Claude ships with the engine

# ===== Local environment and build output =====
.venv/
node_modules/
dist/
build/
# harness/tools/build holds the build scripts, not build output
!harness/tools/build/
# the project skeleton keeps its (empty) build folders
!harness/config/pmo/templates/**/build/
__pycache__/
.cov/
.coverage*
*.pyc
*.plugin
.env
.env.*
!.env.example
.claude/*
!.claude/README.md
_out/
*.bak
*.tmp
Thumbs.db
*.egg-info/

# Architecture engine: training samples (third-party plans and books) and what the scripts generate from them
/harness/src/engines/cad/arch/samples/
/harness/src/engines/cad/arch/out/


# Projects: client data never enters the platform repository (PRD section 17); the template and the README stay
/projects/*
!/projects/README.md
!/projects/_template/
# Intermediate results of pipeline runs (the template keeps its README)
/projects/*/runs/*
!/projects/_template/runs/README.md
# Standards' PDFs and other normative sources: local only, read-only
/harness/knowledge/normative/*
!/harness/knowledge/normative/README.md

# ===== More copyrighted / binary material =====
*.docx
*.doc
*.epub
*.mobi
*.djvu
!harness/**/templates/**/*.docx
